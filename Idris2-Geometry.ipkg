package Idris2-Geometry
version = 0.3.2
authors = "Justin Kelly"
brief   = "Layer 3a Discrete Kinematics & Differential Geometry Subsystem."

depends = base, linear, Idris2-Multiset-Core, Idris2-Multiset-Transform, Idris2-Multiset-Ternary, Idris2-Dihedron
sourcedir = "src"

modules = Geometry,
          Core.CosmicScaleTransform,
          Geometry.Applicative,
          Geometry.GrassmannCalculus,
          Geometry.InformationGeometry,
          Geometry.LatticeTopology,
          Geometry.LatticeStream,
          Geometry.MetricalBounds,
          Geometry.MonadicMetricSpace,
          Math.ChromoCategory,
          Math.CliffordAlgebra,
          Math.ExclusionPrinciple,
          Math.FourGeometries,

          Math.LinAlgebra.BilinearProduct,
          Math.LinAlgebra.MetricTensor,
          Math.LinAlgebra.TernaryClassifier,
          Math.MotivicProof,
          Math.MultisetMetricTensor55,
          Math.QuantumTransition,
          Math.RationalTrig,
          Math.SubstrateMetricTensor55,
          Math.SpatialProjection,
          Math.WilsonPolyhedra

